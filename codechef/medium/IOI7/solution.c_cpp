#include <bits/stdc++.h>

using namespace std;

void solve()
{
    int N, G;
    cin >> N >> G;

    if (N >= G)
    {
        cout << "Yes";
    }
    else
    {
        cout << "No";
    }
}

int main()
{
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t = 1;
    // cin >> t;

    while (t--)
    {
        solve();
    }

    return 0;
}